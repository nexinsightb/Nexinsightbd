# Google Apps Script Web App Deployment URL (server-side only)
# This is used by the /api/contact route to proxy form submissions.
# Replace with your deployed Apps Script Web App URL:
# Example: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
